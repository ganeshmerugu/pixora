# Pixora Environment — cp .env.example .env

# Database (SQLite dev / PostgreSQL prod)
PIXORA_DATABASE_URL=sqlite+aiosqlite:///pixora.db
# PIXORA_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/pixora
# PIXORA_REDIS_URL=redis://localhost:6379/0

# AI Providers (Gemini is free)
PIXORA_GEMINI_API_KEY=
# PIXORA_GROQ_API_KEY=
# PIXORA_TOGETHER_API_KEY=
# PIXORA_ANTHROPIC_API_KEY=
# PIXORA_REPLICATE_API_TOKEN=

# Auth
PIXORA_JWT_SECRET=change-me
# PIXORA_GOOGLE_CLIENT_ID=
# PIXORA_GOOGLE_CLIENT_SECRET=

# Stripe
# PIXORA_STRIPE_SECRET_KEY=
# PIXORA_STRIPE_WEBHOOK_SECRET=

# Email
# PIXORA_SMTP_HOST=smtp.gmail.com
# PIXORA_SMTP_USER=
# PIXORA_SMTP_PASSWORD=

# S3 Storage
# PIXORA_S3_BUCKET=
# PIXORA_S3_ACCESS_KEY=
# PIXORA_S3_SECRET_KEY=

# Monitoring
# PIXORA_SENTRY_DSN=

# Settings
PIXORA_DEPLOYMENT_MODE=serverless
PIXORA_DEFAULT_TIER=1
PIXORA_BUDGET_LIMIT_USD=1.0
PIXORA_TLS_VERIFY=true
