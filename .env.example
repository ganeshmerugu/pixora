# Pixora Environment Variables
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# VLM — for degraded scan escalation (Gemini is free: https://aistudio.google.com/apikey)
PIXORA_GEMINI_API_KEY=

# LLM extraction — serverless, pay-per-token
PIXORA_GROQ_API_KEY=
PIXORA_TOGETHER_API_KEY=

# Enterprise APIs (optional — highest quality, highest cost)
PIXORA_ANTHROPIC_API_KEY=
PIXORA_OPENAI_API_KEY=

# Image VLM
PIXORA_REPLICATE_API_TOKEN=

# Google OAuth (optional — for user login)
PIXORA_GOOGLE_CLIENT_ID=
PIXORA_GOOGLE_CLIENT_SECRET=
PIXORA_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Security
PIXORA_JWT_SECRET=

# Budget
PIXORA_BUDGET_LIMIT_USD=1.0
PIXORA_DEFAULT_TIER=1
PIXORA_DEPLOYMENT_MODE=serverless
